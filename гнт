<script type="module">
const MODEL_ID='Llama-3.2-1B-Instruct-q4f16_1-MLC';
const SYSTEM='Ты — AIKI, универсальный ИИ-ассистент от AIRE STUDIOS. Отвечай на том языке, на котором пишет пользователь. Отвечай понятно и по делу. Не помогай с оружием, вредоносным кодом и другими опасными запросами.';
// Message filter for AIRE: profanity (RU + EN, also with letter tricks), random letter junk, symbol-only text.
const LEET={'0':'o','1':'i','3':'e','4':'a','5':'s','7':'t','8':'b','@':'a','$':'s','!':'i','|':'l'};
const BAD_RU=['хуй','хуе','хуё','хуя','хую','пизд','ебат','ебан','ебл','ёб','ебу','блят','бляд','бляь','сука','суки','сучк','мудак','мудил','гандон','залуп','манд','шлюх','дроч','пидор','пидар','долбоеб','мразь'];
const BAD_EN=['fuck','shit','bitch','asshole','dick','cunt','nigga','nigger','faggot','whore','slut','bastard','retard','porn'];
const BAD_EN_WORDS=['ass'];
const KEYS=['qwer','asdf','zxcv','ghjk','hjkl','йцук','фыва','ячсм','ыфв','ячс'];
const RU_V='аеёиоуыэюя', EN_V='aeiouy';
function normWord(w){return w.split('').map(ch=>LEET[ch]||ch).join('')}
function lettersOnly(s){return s.replace(/[^a-zа-яё]/g,'')}
function isJunkToken(t){
  if(/[a-z]/.test(t)&&/[а-яё]/.test(t))return true;           // mixed alphabets in one word
  if(/(.)\1\1/.test(t))return true;                             // sss, aaa, ооо
  if(/[бвгджзйклмнпрстфхцчшщbcdfghjklmnpqrstvwxz]{5,}/.test(t))return true; // long consonant runs
  if(t.length>=4&&!new RegExp('['+RU_V+EN_V+']').test(t))return true;      // no vowels at all
  if(KEYS.some(k=>t.includes(k)))return true;                   // keyboard mash
  return false;
}
function checkText(text){
  const raw=String(text||'').trim();
  if(!raw)return 'Пустое сообщение';
  const lower=raw.toLowerCase().replace(/ё/g,'е');
  const tokens=lower.split(/[^a-zа-яе0-9@$!|]+/).map(normWord).map(lettersOnly).filter(Boolean);
  const squashed=tokens.join('');
  // profanity: stems inside a word, and inside squashed text (catches "х у й" and "f.u.c.k")
  const badStems=BAD_RU.map(s=>s.replace(/ё/g,'е')).concat(BAD_EN);
  for(const t of tokens){
    if(badStems.some(b=>t.includes(b)))return 'Сообщение содержит запрещённые слова';
    if(BAD_EN_WORDS.includes(t))return 'Сообщение содержит запрещённые слова';
  }
  if(badStems.some(b=>squashed.includes(b)))return 'Сообщение содержит запрещённые слова';
  // letters: has words?
  const letterTokens=tokens.filter(t=>/[a-zа-я]/.test(t));
  if(letterTokens.length===0){
    // no words at all: only digits and symbols. Allowed only if it looks like a math/number question
    return /[0-9]/.test(raw)?null:'Напиши сообщение словами';
  }
  const junk=letterTokens.filter(isJunkToken);
  if(junk.length>=3||(junk.length>0&&junk.length/letterTokens.length>=0.4))return 'Сообщение похоже на набор случайных букв. Напишите нормальным текстом.';
  return null;
}

const $=id=>document.getElementById(id);

function load(){try{const d=JSON.parse(localStorage.getItem('aire_local_v1')||'null');if(d)return d}catch(e){}
  return {chats:[],activeId:null,theme:'gold',lang:'auto',lastVisit:0}}
let st=load();
function save(){try{localStorage.setItem('aire_local_v1',JSON.stringify(st))}catch(e){}}
function uid(){return Math.random().toString(36).slice(2,10)}
function active(){return st.chats.find(c=>c.id===st.activeId)||null}
function toast(t){const el=$('toast');el.textContent=t;el.style.display='block';clearTimeout(toast._t);toast._t=setTimeout(()=>el.style.display='none',3000)}
function greet(){const h=new Date().getHours();return h<5?'Доброй ночи':h<12?'Доброе утро':h<18?'Добрый день':'Добрый вечер'}
function applyTheme(){document.body.setAttribute('data-theme',st.theme)}

// ---------- model ----------
let engine=null, loading=null, progress='';
function renderCounter(){
  if(progress){$('counter').textContent=progress;return}
  if(hasKey()){$('counter').textContent='Gemini (ваш ключ)'+(st.search?' · поиск':'')+(st.think?' · Think harder':'');return}
  $('counter').textContent=engine?'Локальная модель · Llama 3.2 1B':'Локальная модель · загрузится при первом сообщении';
}
function getEngine(){
  if(engine)return Promise.resolve(engine);
  if(!navigator.gpu)return Promise.reject(new Error('Этот браузер не поддерживает WebGPU. Откройте сайт в Chrome или Edge на компьютере, либо в новой версии Safari.'));
  if(!loading){
    loading=import('https://esm.run/@mlc-ai/web-llm').then(webllm=>webllm.CreateMLCEngine(MODEL_ID,{initProgressCallback:r=>{progress='Загрузка модели: '+Math.round((r.progress||0)*100)+'%';renderCounter()}}))
      .then(e=>{engine=e;progress='';renderCounter();return e})
      .catch(err=>{loading=null;progress='';renderCounter();throw err});
  }
  return loading;
}

// ---------- toggles (work with a Gemini key; without a key they explain why) ----------
let pending=null;
function hasKey(){try{return !!localStorage.getItem('aire_gemini_key')}catch(e){return false}}
$('tSearch').onclick=()=>{if(!hasKey())return toast('Поиск нужен ключ Gemini: добавьте его в настройках ⚙');st.search=!st.search;save();renderToggles()};
$('tThink').onclick=()=>{if(!hasKey())return toast('Think harder нужен ключ Gemini: добавьте его в настройках ⚙');st.think=!st.think;save();renderToggles()};
$('photoBtn').onclick=()=>{if(!hasKey())return toast('Анализ фото нужен ключ Gemini: добавьте его в настройках ⚙');$('photo').click()};
$('photo').onchange=e=>{
  const f=e.target.files&&e.target.files[0];if(!f)return;
  const img=new Image();const url=URL.createObjectURL(f);
  img.onload=()=>{
    const k=Math.min(1,1024/Math.max(img.width,img.height));
    const cv=document.createElement('canvas');cv.width=Math.round(img.width*k);cv.height=Math.round(img.height*k);
    cv.getContext('2d').drawImage(img,0,0,cv.width,cv.height);
    pending={mime:'image/jpeg',data:cv.toDataURL('image/jpeg',.85).split(',')[1]};
    $('att').textContent='📷 Фото прикреплено · нажми здесь, чтобы убрать';
    $('att').onclick=()=>{pending=null;$('att').textContent='';$('photo').value=''};
    URL.revokeObjectURL(url);
  };
  img.src=url;
};
function renderToggles(){
  $('tSearch').classList.toggle('on',!!st.search&&hasKey());
  $('tThink').classList.toggle('on',!!st.think&&hasKey());
  renderCounter();
}

// ---------- chats ----------
function newChat(){const c={id:uid(),title:'Новый чат',messages:[]};st.chats.unshift(c);st.activeId=c.id;save();renderAll();if(innerWidth<=700)$('side').classList.add('closed');$('input').focus()}
function renameChat(id){const c=st.chats.find(x=>x.id===id);if(!c)return;const t=prompt('Новое название чата',c.title);if(t&&t.trim()){c.title=t.trim().slice(0,60);save();renderList()}}
function deleteChat(id){if(!confirm('Удалить чат?'))return;st.chats=st.chats.filter(x=>x.id!==id);if(st.activeId===id)st.activeId=st.chats[0]?st.chats[0].id:null;save();renderAll()}
function renderList(){
  const list=$('list');list.innerHTML='';
  st.chats.forEach(c=>{
    const row=document.createElement('div');row.className='chat'+(c.id===st.activeId?' active':'');
    row.innerHTML='<span class="t"></span><button class="x" title="Переименовать">✎</button><button class="x" title="Удалить">🗑</button>';
    row.querySelector('.t').textContent=c.title;
    row.addEventListener('click',e=>{if(e.target.closest('.x'))return;st.activeId=c.id;save();renderAll();if(innerWidth<=700)$('side').classList.add('closed')});
    const bs=row.querySelectorAll('.x');
    bs[0].onclick=e=>{e.stopPropagation();renameChat(c.id)};
    bs[1].onclick=e=>{e.stopPropagation();deleteChat(c.id)};
    list.appendChild(row);
  });
}
function getProfile(){try{return JSON.parse(localStorage.getItem('aire_profile')||'{}')}catch(e){return {}}}
function saveProfile(p){try{localStorage.setItem('aire_profile',JSON.stringify({...getProfile(),...p}))}catch(e){}}
function aireGreeting(){
  const p=getProfile();const name=[p.name,p.surname].filter(Boolean).join(' ');
  const visits=p.visits||1;
  const now=new Date();const h=now.getHours();
  if(!name)return greet()+'!';
  if(visits<=1)return 'Добро пожаловать, '+name+'!';
  if(h>=5&&h<12)return 'Доброе утро, '+name+'!';
  if(h>=18)return 'Добрый вечер, '+name+'!';
  const pool=['Привет, '+name+'. Начнём, когда будете готовы.','С возвращением, '+name+'!'];
  return pool[Math.floor(Math.random()*pool.length)];
}
function renderChat(){
  const box=$('chat');box.innerHTML='';const c=active();
  if(!c||!c.messages.length){
    const h=document.createElement('div');h.className='hello';
    const back=st.lastVisit&&(Date.now()-st.lastVisit>12*3600*1000);
    h.innerHTML='<b>'+(back&&!getProfile().name?'С возвращением!':aireGreeting())+'</b>Я AIKI. Спроси что угодно: вопрос, код, перевод или идею. Всё работает прямо в вашем браузере, ключ не нужен.';
    box.appendChild(h);return;
  }
  c.messages.forEach(m=>addBubble(m.role,m.text,false));
  box.scrollTop=box.scrollHeight;
}
function addBubble(role,text,err){
  const d=document.createElement('div');d.className='msg '+(role==='user'?'user':'bot')+(err?' err':'');
  d.textContent=text;
  if(role!=='user'&&!err){const b=document.createElement('button');b.className='say';b.textContent='🔊 Озвучить';b.onclick=()=>speak(text);d.appendChild(document.createElement('br'));d.appendChild(b)}
  $('chat').appendChild(d);$('chat').scrollTop=$('chat').scrollHeight;return d;
}
function renderAll(){renderList();renderChat();renderToggles();applyTheme()}

// ---------- voice ----------
function speak(text){
  if(!('speechSynthesis' in window))return toast('Озвучка не поддерживается в этом браузере');
  speechSynthesis.cancel();const u=new SpeechSynthesisUtterance(text);u.lang=/[а-яё]/i.test(text)?'ru-RU':'en-US';speechSynthesis.speak(u);
}
let rec=null;
$('mic').onclick=()=>{
  const SR=window.SpeechRecognition||window.webkitSpeechRecognition;
  if(!SR)return toast('Голосовой ввод не поддерживается в этом браузере');
  if(rec){rec.stop();return}
  rec=new SR();rec.lang=st.lang==='en'?'en-US':'ru-RU';rec.interimResults=false;
  rec.onresult=e=>{$('input').value=(($('input').value+' ')+e.results[0][0].transcript).trim()};
  rec.onend=()=>{rec=null;$('mic').classList.remove('rec')};
  rec.onerror=()=>{rec=null;$('mic').classList.remove('rec');toast('Не удалось распознать голос')};
  $('mic').classList.add('rec');rec.start();
};

// ---------- send ----------
async function askOpenAI(key,base,model,history,image){
  const sys=SYSTEM+(st.lang==='ru'?' Отвечай только по-русски.':st.lang==='en'?' Answer only in English.':'')+(st.think?' Перед ответом коротко рассуждай по шагам.':'');
  const msgs=[{role:'system',content:sys}].concat(history.map(m=>({role:m.role==='assistant'?'assistant':'user',content:m.text})));
  const url=base.replace(/\/+$/,'')+'/chat/completions';
  const r=await fetch(url,{method:'POST',headers:{'Content-Type':'application/json','Authorization':'Bearer '+key},
    body:JSON.stringify({model:model||'default',messages:msgs,max_tokens:st.think?1200:600,temperature:0.7})});
  const data=await r.json().catch(()=>({}));
  if(!r.ok)throw new Error((data.error&&(data.error.message||data.error))||('Ошибка '+r.status));
  const text=((data.choices&&data.choices[0]&&data.choices[0].message&&data.choices[0].message.content)||'').trim();
  if(!text)throw new Error('Пустой ответ от сервиса');
  return text;
}
async function askGemini(key,history,image){
  const contents=history.map(m=>({role:m.role==='assistant'?'model':'user',parts:[{text:m.text}]}));
  if(image){const last=contents[contents.length-1];last.parts=[{inline_data:{mime_type:image.mime,data:image.data}},{text:last.parts[0].text||'Что на фото?'}]}
  const sys=SYSTEM+(st.lang==='ru'?' Отвечай только по-русски.':st.lang==='en'?' Answer only in English.':'');
  const body={systemInstruction:{parts:[{text:sys}]},contents,generationConfig:{thinkingConfig:{thinkingBudget:st.think?8192:0}}};
  if(st.search)body.tools=[{google_search:{}}];
  const r=await fetch('https://generativelanguage.googleapis.com/v1beta/models/'+encodeURIComponent((function(){try{return localStorage.getItem('aiki_model')||'gemini-2.5-flash'}catch(e){return 'gemini-2.5-flash'}})())+':generateContent',{
    method:'POST',headers:{'Content-Type':'application/json','x-goog-api-key':key},body:JSON.stringify(body)});
  const data=await r.json().catch(()=>({}));
  if(!r.ok)throw new Error((data.error&&data.error.message)||('Ошибка Gemini '+r.status));
  const text=((data.candidates&&data.candidates[0]&&data.candidates[0].content&&data.candidates[0].content.parts)||[]).map(p=>p.text||'').join('').trim();
  if(!text)throw new Error('Пустой ответ от Gemini');
  return text;
}
$('f').addEventListener('submit',async e=>{
  e.preventDefault();
  const text=$('input').value.trim();if(!text&&!pending)return;
  const badMsg=checkText(text);if(text&&badMsg){toast(badMsg);return}
  if(!active())newChat();
  const c=active();
  const image=pending;pending=null;$('att').textContent='';$('photo').value='';
  const shown=(image?'📷 ':'')+(text||'Что на фото?');
  $('input').value='';$('input').style.height='auto';
  if(c.messages.length===0)c.title=shown.slice(0,40);
  c.messages.push({role:'user',text:shown});save();
  $('chat').querySelector('.hello')?.remove();
  addBubble('user',shown);
  const wait=addBubble('bot','AIKI…');wait.classList.add('typing');
  $('send').disabled=true;
  try{
    const key=(()=>{try{return localStorage.getItem('aire_gemini_key')||''}catch(e){return ''}})();
    const history=c.messages.slice(-20).map(m=>({role:m.role,text:m.text}));
    let reply;
    if(key){
      let base='',model='';try{base=localStorage.getItem('aiki_base')||'';model=localStorage.getItem('aiki_model')||''}catch(e){}
      if(base){if(image)throw new Error('Фото пока работает только с Gemini');reply=await askOpenAI(key,base,model,history,image)}
      else reply=await askGemini(key,history,image);
    }else{
      if(image)throw new Error('Фото можно отправить только с ключом Gemini');
      const eng=await getEngine();
      const msgs=[{role:'system',content:SYSTEM+(st.lang==='ru'?' Отвечай только по-русски.':st.lang==='en'?' Answer only in English.':'')}]
        .concat(c.messages.slice(-12).map(m=>({role:m.role==='assistant'?'assistant':'user',content:m.text})));
      const out=await eng.chat.completions.create({messages:msgs,max_tokens:600,temperature:0.7});
      reply=(out.choices&&out.choices[0]&&out.choices[0].message.content||'').trim()||'Не удалось получить ответ.';
    }
    wait.remove();
    c.messages.push({role:'assistant',text:reply});save();renderList();addBubble('assistant',reply);
  }catch(err){
    wait.remove();
    c.messages.pop();save();renderChat();
    const m=String(err&&err.message||'');
    const friendly=/fetch|import|network|Failed/i.test(m)?'Не удалось связаться с сервером. Проверьте интернет.':(m||'Ошибка');
    addBubble('assistant',friendly,true);
  }finally{$('send').disabled=false;$('input').focus()}
});
$('input').addEventListener('input',()=>{$('input').style.height='auto';$('input').style.height=Math.min($('input').scrollHeight,140)+'px'});
$('input').addEventListener('keydown',e=>{if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();$('f').requestSubmit()}});

// ---------- header / settings ----------
$('newChat').onclick=newChat;
$('toggleSide').onclick=()=>$('side').classList.toggle('closed');
$('openSettings').onclick=()=>{try{$('sBase').value=localStorage.getItem('aiki_base')||'https://api.zveno.ai/v1';$('sModel').value=localStorage.getItem('aiki_model')||'ERNIE-5.5-Flash-Preview'}catch(e){};let k='';try{k=localStorage.getItem('aire_gemini_key')||''}catch(e){};const pf=getProfile();$('sName').value=pf.name||'';$('sSurname').value=pf.surname||'';$('sBirth').value=pf.birth||'';$('sKey').value=k;$('sLang').value=st.lang;$('sTheme').value=st.theme;$('modal').classList.add('show')};
$('sClose').onclick=()=>$('modal').classList.remove('show');
$('sSave').onclick=()=>{
  const k=$('sKey').value.trim();
  try{localStorage.setItem('aiki_base',$('sBase').value.trim());localStorage.setItem('aiki_model',$('sModel').value.trim())}catch(e){}
  const nm=$('sName').value.trim(),sn=$('sSurname').value.trim(),bd=$('sBirth').value.trim();
  if(bd&&!/^\d{2}\.\d{2}\.\d{4}$/.test(bd)){toast('Дата рождения в формате ДД.ММ.ГГГГ');return}
  saveProfile({name:nm,surname:sn,birth:bd});
  try{if(k)localStorage.setItem('aire_gemini_key',k);else localStorage.removeItem('aire_gemini_key')}catch(e){}
  st.lang=$('sLang').value;st.theme=$('sTheme').value;save();applyTheme();renderToggles();
  $('modal').classList.remove('show');toast(k?'Сохранено: ответы через Gemini':'Сохранено: ответы через локальную модель');
};

// ---------- start ----------
if(!active()&&st.chats.length)st.activeId=st.chats[0].id;
st.lastVisit=Date.now();save();
if(getProfile().name)saveProfile({visits:(getProfile().visits||0)+1});
renderAll();
</script>
